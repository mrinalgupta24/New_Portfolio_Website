# Copy to .env.local for local development, and add the same variable in
# Vercel → Project → Settings → Environment Variables for production.
# Web3Forms access key (dashboard → Portfolio Contact form).
VITE_WEB3FORMS_ACCESS_KEY=

# Optional: Cloudflare Web Analytics beacon token (dash.cloudflare.com → Web Analytics → site → JS snippet)
VITE_CF_BEACON_TOKEN=

# Optional: Microsoft Clarity project ID (clarity.microsoft.com → Settings → Overview)
VITE_CLARITY_ID=

# Optional: "Ask Mrinal's AI". GEMINI_API_KEY is server-only (never exposed to the browser).
# Get a free key at https://aistudio.google.com/apikey, then set VITE_ASSISTANT_ENABLED=true.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
VITE_ASSISTANT_ENABLED=false

# Optional backup AI when Gemini is down (console.groq.com). Server-only.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Optional: themed /status page (Better Stack → Settings → API tokens; status page id from its URL). Server-only.
BETTERSTACK_API_TOKEN=
BETTERSTACK_STATUS_PAGE_ID=

# Optional: log AI questions to a Google Sheet (see docs/chat-log-apps-script.gs). Server-only.
CHAT_LOG_WEBHOOK_URL=
CHAT_LOG_SECRET=
